# CV Service Configuration
# CV_SERVICE = which backend: "yolo" = local ONNX (model from MODEL_PATH), "rekognition" = AWS
CV_SERVICE=yolo

# YOLO model file (YOLOv8 or YOLO26 ONNX; path relative to cv-service/)
MODEL_PATH=../models/yolo26m.onnx

YOLO_CONFIDENCE=0.25
YOLO_IOU=0.45

# AWS Configuration (only needed when CV_SERVICE=rekognition)
AWS_REGION=eu-central-1
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
