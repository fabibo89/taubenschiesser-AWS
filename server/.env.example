# ============================================
# Taubenschiesser Server Configuration
# ============================================

# Environment
NODE_ENV=development
PORT=5001

# ============================================
# Database Configuration
# ============================================
# Lokal mit Docker:
MONGODB_URI=mongodb://admin:password123@localhost:27017/taubenschiesser?authSource=admin

# Für AWS DocumentDB (auskommentiert):
# MONGODB_URI=mongodb://admin:your-password@your-docdb-endpoint:27017/taubenschiesser?ssl=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# ============================================
# Frontend & Services
# ============================================
CLIENT_URL=http://localhost:3000
CV_SERVICE_URL=http://localhost:8000

# ============================================
# MQTT Configuration
# ============================================
# Wähle EINE der beiden Optionen:

# --- Option 1: Lokales MQTT mit Mosquitto (AKTIV) ---
# Keine Konfiguration hier nötig!
# MQTT Settings werden über das Dashboard (Profil -> Einstellungen) konfiguriert
# Standard: localhost:1883

# --- Option 2: AWS IoT Core (INAKTIV - zum Aktivieren Kommentare entfernen) ---
# Nach Terraform Deployment diese Werte eintragen:
# AWS_IOT_ENDPOINT=xxxxx-ats.iot.eu-central-1.amazonaws.com
# AWS_REGION=eu-central-1

# AWS Credentials (nur nötig wenn NICHT über IAM Role):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=secret...

# ============================================
# YOLO Dataset → Google Drive (empfohlen für Colab)
# ============================================
# Service Account in Google Cloud anlegen → JSON-Key herunterladen.
# Zielordner in Drive mit der Service-Account-Mail teilen (Rolle: Bearbeiter).
# GOOGLE_DRIVE_CREDENTIALS_JSON=./secrets/google-drive-sa.json
# Oder den JSON-Inhalt direkt (eine Zeile):
# GOOGLE_DRIVE_CREDENTIALS_JSON={"type":"service_account","client_email":"...","private_key":"..."}
# Ordner-ID oder kompletter Ordner-Link:
# GOOGLE_DRIVE_FOLDER_ID=1AbCdefGhIjKlMnOpQrStUvWxYz
# GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/1AbCdefGhIjKlMnOpQrStUvWxYz
# Optional: E-Mail für UI-Hinweis (sonst aus dem JSON-Key):
# GOOGLE_DRIVE_CLIENT_EMAIL=taubenschiesser-export@your-project.iam.gserviceaccount.com
# Colab-Pfad-Prefix (muss zum Ordner unter „Meine Ablage“ passen):
# GOOGLE_DRIVE_COLAB_PATH_PREFIX=/content/drive/MyDrive/taubenschiesser
# Auto-Upload nach jedem fertigen Export:
# GOOGLE_DRIVE_AUTO_UPLOAD=false

# ============================================
# YOLO Dataset → Google Colab (S3, optional)
# ============================================
# Alternative zu Drive: Export-ZIP nach S3; Colab lädt per DATASET_URL.
# DATASET_S3_BUCKET=your-colab-datasets-bucket
# DATASET_S3_PREFIX=yolo-exports/
# DATASET_S3_REGION=eu-central-1
# Presigned URL lifetime in seconds (default 86400 = 24h):
# DATASET_S3_URL_EXPIRES=86400
# Optional public/CloudFront base (no trailing slash). If set, no presign is used:
# DATASET_S3_PUBLIC_BASE=https://dxxxxx.cloudfront.net
# Auto-upload every finished export when bucket is set:
# DATASET_S3_AUTO_UPLOAD=false

# ============================================
# NAS (SMB) — Frozen exports / Training artifacts
# ============================================
# macOS mount (Finder / already connected):
#   smb://fabian@NAS._smb._tcp.local/photo
#   → /Volumes/photo/Uploads/GoogleDrive/taubentraining
# Protocol: SMB (AFP deprecated; NFS optional separately).
# NAS_SMB_HOST=NAS._smb._tcp.local
# NAS_SMB_SHARE=photo
# NAS_SMB_USER=fabian
# NAS_SMB_PASSWORD=
# NAS_SMB_URL=smb://fabian@NAS._smb._tcp.local/photo
# Local mount root after connect:
# NAS_MOUNT_ROOT=/Volumes/photo
# Training tree on that share (preferred when present):
# NAS_TRAINING_ROOT=/Volumes/photo/Uploads/GoogleDrive/taubentraining
# Offline fallback when NAS path is missing (same Trainingsdata/ + result/ layout):
# LOCAL_TRAINING_ROOT=/Users/fabianbosch/Documents/Taubenschießer

# ============================================
# Host Val (Ultralytics / ESPDet)
# ============================================
# Python with ultralytics installed (system python3 usually lacks it).
# Prefer the esp-detection venv if present:
# ULTRALYTICS_PYTHON=/Users/fabianbosch/Documents/GitHub/esp-detection/.venv/bin/python
# Alias:
# HOST_VAL_PYTHON=/Users/fabianbosch/Documents/GitHub/esp-detection/.venv/bin/python
# ESPDet .pt needs the esp-detection repo (local nn package + parse_model patch):
# ESP_DETECTION_ROOT=/Users/fabianbosch/Documents/GitHub/esp-detection
# Device for model.val (default cpu):
# HOST_VAL_DEVICE=cpu
# Do not let Ultralytics auto-pip-install a PyPI package named "nn" (breaks ESPDet):
# YOLO_AUTOINSTALL=False

# ============================================
# Hinweise:
# ============================================
# 1. Kopiere diese Datei zu .env: cp .env.example .env
# 2. Passe die Werte in .env an (niemals in .env.example!)
# 3. .env wird NICHT ins Git committed (steht in .gitignore)
# 4. .env.example wird ins Git committed (als Template)
